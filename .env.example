# =============================================================
# HTML5 + GSAP Video Generator - Environment Configuration
# Copy this file to .env and insert your actual API credentials.
# Never commit .env with real credentials to version control.
# =============================================================

# Nexus AI LLM Configuration (Script Planning & Generation)
NEXUS_API_URL=https://nexusapi.navigatelabs.ai/v1
NEXUS_API_KEY=your_nexus_api_key_here
NEXUS_MODEL=gpt-5.6-luna

# AWS Polly Voice Integration (via Nexus /v1/audio/speech Endpoint)
NEXUS_VOICE_URL=https://nexusapi.navigatelabs.ai/v1
NEXUS_VOICE_API_KEY=your_nexus_api_key_here
POLLY_VOICE_ID=Joanna
POLLY_ENGINE=standard
POLLY_OUTPUT_FORMAT=mp3

# Video Rendering Specifications
VIDEO_WIDTH=1920
VIDEO_HEIGHT=1080
VIDEO_FPS=30
